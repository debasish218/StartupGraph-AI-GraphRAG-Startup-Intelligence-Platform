# Copy to .env and adjust. Used by docker compose and by the backend when run locally.

ENVIRONMENT=development
LOG_LEVEL=INFO
# Required in production for /api/ingest/* (send as X-API-Key header)
ADMIN_API_KEY=

# Databases (local defaults match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=startupgraph
POSTGRES_PASSWORD=startupgraph
POSTGRES_DSN=postgresql://startupgraph:startupgraph@localhost:5432/startupgraph

# LLM: none (rule-based agents, no key needed) | openai | gemini | anthropic
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: local (sentence-transformers) | openai | gemini | hash (tests only)
# EMBEDDING_DIM must match the model: all-MiniLM-L6-v2=384, text-embedding-3-small=384..1536 (configurable),
# Gemini text-embedding-004=768. After switching models run: python -m app.ingestion.reindex
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_DIM=384
# Docker build: set to false for a slim backend image when using API embeddings
INSTALL_ML=true

# News intelligence pipeline
RSS_POLL_MINUTES=0
RSS_FEEDS=https://techcrunch.com/category/startups/feed/,https://techcrunch.com/category/artificial-intelligence/feed/,https://techcrunch.com/category/venture/feed/
GITHUB_TOKEN=
SEED_ON_STARTUP=true

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
